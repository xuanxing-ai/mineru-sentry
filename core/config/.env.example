# ==============================================================================
# MinerU-Sentry 统一环境配置模板 (.env.example)
# 
# 使用说明：
# 1. 复制本文件生成开发或生产配置文件：
#    cp core/config/.env.example core/config/.env.dev
# 2. 支持通过环境变量 CONFIG_FILE_PATH 指定加载的配置文件路径（默认读取 .env.dev）
# 3. 进程环境变量的优先级高于配置文件中的同名项
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 网关与服务配置 (Server & Gateway Configuration)
# ------------------------------------------------------------------------------
# SENTRY_HOST: 网关服务内部监听地址。
# 可选值: 
#   - 0.0.0.0 (允许所有网卡访问，容器内部部署必须使用 0.0.0.0)
#   - 127.0.0.1 (仅允许本机回环访问)
SENTRY_HOST=0.0.0.0
# SERVICE_PORT: 网关服务内部监听端口。
# 可选值: 1 ~ 65535 的整数，推荐 8080。
SERVICE_PORT=8080
# SENTRY_PORT: 兼容旧版本保留的端口配置项，与 SERVICE_PORT 保持一致即可。
# 可选值: 1 ~ 65535 的整数。
SENTRY_PORT=8080
# LOG_PATH: 应用运行日志的存储目录。
# 可选值: 
#   - 相对路径（如 docs/logs 或 logs，基于项目根目录解析）
#   - 绝对路径（如 /usr/model/MinerU/data/logs）
LOG_PATH=docs/logs
# LOG_NAME: 生成的日志文件名前缀，实际输出文件名格式为 <LOG_NAME>.log。
# 可选值: 任意合法文件名字符串，如 mineru-sentry。
LOG_NAME=mineru-sentry
# LOG_LEVEL: 日志输出最低级别。
# 可选值: DEBUG, INFO, WARNING, ERROR, CRITICAL。
# 生产环境推荐 INFO，调试排错可临时调整为 DEBUG。
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 2. 数据库连接配置 (Database - PostgreSQL Connection Only)
# 说明：本项目仅负责连接 PostgreSQL 进行任务断点、分片和结果的持久化。
# 不限制数据库的部署位置（可在本机、远程主机或独立 Docker 容器中运行）。
# 若留空 POSTGRES_URL，网关会自动跳过数据库初始化，仅开放系统健康检查等 API。
# ------------------------------------------------------------------------------
# POSTGRES_URL: PostgreSQL 数据库主机地址或完整 SQLAlchemy 连接串。
# 可选值: 
#   - 主机 IP 或域名（如 127.0.0.1, localhost, host.docker.internal 或远程 IP）
#   - 完整连接字符串（如 postgresql+psycopg2://user:pass@host:5432/dbname）
#   - 空字符串 ""（不连接数据库，禁用解析相关接口）
POSTGRES_URL=127.0.0.1
# POSTGRES_PORT: PostgreSQL 监听端口。
# 可选值: 1 ~ 65535 的整数，默认 5432。
POSTGRES_PORT=5432
# POSTGRES_DATABASE: 存储 MinerU 任务与断点记录的数据库名。
# 可选值: 数据库标识符字符串，必须已在 PostgreSQL 中创建（如 mineru_sentry）。
POSTGRES_DATABASE=mineru_sentry
# POSTGRES_USERNAME: 连接数据库的用户名。
# 可选值: 具备建表和数据增删改查权限的用户标识（如 mineru_admin）。
POSTGRES_USERNAME=mineru_admin
# POSTGRES_PASSWORD: 连接数据库的用户密码。
# 可选值: 对应数据库用户的凭据字符串。部署时请修改为实际密码。
POSTGRES_PASSWORD=mineru_password

# ------------------------------------------------------------------------------
# 3. Docker 与 GPU Worker 容器生命周期管理 (Docker & GPU Lifecycle)
# ------------------------------------------------------------------------------
# DOCKER_HOST: Docker Engine API 套接字路径或地址。
# 可选值:
#   - unix:///var/run/docker.sock (本地 Linux 守护进程 UNIX 套接字)
#   - tcp://127.0.0.1:2375 (远程或本地 TCP API，若开启了 Docker TCP 端口)
DOCKER_HOST=unix:///var/run/docker.sock
# MINERU_WORKER_CONTAINER_NAME: GPU 推理 Worker 容器名称。
# 可选值: 字符串，必须与 compose.yaml 中的 container_name 一致（默认 mineru_gpu_worker）。
MINERU_WORKER_CONTAINER_NAME=mineru_gpu_worker
# MINERU_API_URL: Sentry 网关访问 Worker HTTP 接口的完整 Base URL。
# 可选值:
#   - http://mineru_worker:8000 (Compose 内部容器网络互联，默认推荐)
#   - http://127.0.0.1:8000 (宿主机直连开发调试模式)
MINERU_API_URL=http://mineru_worker:8000
# IDLE_TIMEOUT_SECONDS: 无任务时的显存释放空闲倒计时（秒）。
# 可选值: 正整数，单位为秒。
#   - 900 (推荐默认值，15 分钟无活动任务后自动 docker stop 容器，释放 RTX 5090 显存)
#   - 300 (5 分钟，适合快速测试或显存资源极度紧张的场景)
IDLE_TIMEOUT_SECONDS=900
# DEFAULT_MINERU_LOCAL_API_STARTUP_TIMEOUT_SECONDS: 容器唤醒启动到 /health 就绪的最长等待时间（秒）。
# 说明：用于网关客户端等待 Worker 容器就绪，取代旧同义变量 WORKER_STARTUP_TIMEOUT_SECONDS。
# 可选值: 正整数，推荐 300 ~ 600（默认 300）。
DEFAULT_MINERU_LOCAL_API_STARTUP_TIMEOUT_SECONDS=300
# DEFAULT_MINERU_TASK_RESULT_TIMEOUT_SECONDS: 单批次解析任务的最长轮询等待超时（秒）。
# 说明：用于网关客户端轮询单批次结果，取代旧同义变量 WORKER_TASK_TIMEOUT_SECONDS。
# 可选值: 正整数，推荐 1800 ~ 7200（默认 3600，即 1 小时）。
DEFAULT_MINERU_TASK_RESULT_TIMEOUT_SECONDS=3600
# PARSE_BATCH_PAGES: 单个分片/批次解析的 PDF 页数。
# 可选值: 正整数，推荐 1 ~ 5。
#   - 1: 每页落盘一个检查点文件（如 0_0.md, 1_1.md），中断恢复粒度最细，强烈推荐。
#   - 大于 1: 减少向 Worker 发起的 HTTP 请求频次，但批次内单页失败需整批重试。
PARSE_BATCH_PAGES=1

# ------------------------------------------------------------------------------
# 4. 镜像构建与 Compose 部署参数 (Image & Deployment Settings)
# ------------------------------------------------------------------------------
# SENTRY_IMAGE: 网关服务构建生成的镜像名称与标签。
# 可选值: 字符串，如 mineru-sentry:source 或自定义镜像名称。
SENTRY_IMAGE=mineru-sentry:source
# MINERU_IMAGE: GPU Worker 构建生成的镜像名称与标签。
# 可选值: 字符串，如 mineru-api:5090-source。
MINERU_IMAGE=mineru-api:5090-source
# MINERU_BASE_IMAGE: GPU Worker 的基础运行时镜像。
# 可选值:
#   - vllm/vllm-openai:v0.21.0 (官方推荐，内置 CUDA 12.8 / PyTorch / vLLM 运行库)
#   - 其他国内加速镜像源地址（如 registry.cn-hangzhou.aliyuncs.com/...）
MINERU_BASE_IMAGE=vllm/vllm-openai:v0.21.0
# MINERU_SOURCE_DIR: 宿主机上本地 MinerU 源码所在根目录绝对路径。
# 可选值: 本地 MinerU 仓库绝对路径，目录下必须包含 pyproject.toml 与 mineru/ 源码目录。
MINERU_SOURCE_DIR=/home/root/Project/Python/MinerU
# MINERU_GPU_DEVICE_ID: 分配给 Worker 容器使用的 NVIDIA GPU 编号。
# 可选值:
#   - 0, 1, 2... (单卡序号，请使用 nvidia-smi -L 确认 RTX 5090 对应的 GPU 序号)
MINERU_GPU_DEVICE_ID=0
# MINERU_SHM_SIZE: Worker 容器挂载的共享内存 (/dev/shm) 大小。
# 可选值: 16gb, 32gb 等。
# 必须足够大，防止 PyTorch 多进程通信或 vLLM 因 shared memory 不足而 OOM 崩溃。
MINERU_SHM_SIZE=16gb
# SENTRY_BIND_ADDRESS: 宿主机对外映射发布的绑定 IP 地址。
# 可选值:
#   - 0.0.0.0 (允许所有外部网络访问网关)
#   - 127.0.0.1 (仅允许宿主机本机访问网关端口)
SENTRY_BIND_ADDRESS=0.0.0.0
# SENTRY_PUBLISHED_PORT: 宿主机对外暴露的网关 API 端口。
# 可选值: 1 ~ 65535 的整数，推荐 8080。
SENTRY_PUBLISHED_PORT=8080

# ------------------------------------------------------------------------------
# 5. 存储路径与 MinerU 自动配置 (Storage & MinerU Auto Config)
# 说明：系统会在每次启动或唤醒 Worker 时，自动根据以下配置在宿主机和容器内生成
# mineru.json 配置文件，用户完全不需要手动创建或修改 mineru.json。
# ------------------------------------------------------------------------------
# SHARED_DATA_DIR: 宿主机与容器共享的数据根目录。
# 可选值: 绝对路径，推荐 /usr/model/MinerU/data。
# 用于存放上传的 PDF 原始文件、分片中间结果以及合成后的最终 Markdown。
SHARED_DATA_DIR=/usr/model/MinerU/data
# MINERU_CONFIG_FILE: 自动生成的 mineru.json 目标路径。
# 可选值: 绝对路径，推荐 /usr/model/MinerU/mineru.json。
MINERU_CONFIG_FILE=/usr/model/MinerU/mineru.json
# MINERU_PIPELINE_MODEL_DIR: 版面检测与传统 Pipeline 模型存储目录。
# 可选值: 绝对路径，推荐 /usr/model/MinerU/pipeline。
MINERU_PIPELINE_MODEL_DIR=/usr/model/MinerU/pipeline
# MINERU_VLM_MODEL_DIR: 视觉多模态大模型 (VLM) 权重存储目录。
# 可选值: 绝对路径，推荐 /usr/model/MinerU/vlm。
MINERU_VLM_MODEL_DIR=/usr/model/MinerU/vlm
# MINERU_MODEL_SOURCE: 写入 mineru.json 的 model-source 模型源标记。
# 可选值:
#   - modelscope (魔搭社区，国内网络推荐)
#   - huggingface (Hugging Face Hub，国际网络或挂代理时可用)
#   - local (使用本地既有模型目录)
MINERU_MODEL_SOURCE=modelscope

# ------------------------------------------------------------------------------
# 6. Worker API 运行与任务生命周期参数 (Worker API & Task Lifecycle)
# ------------------------------------------------------------------------------
# MINERU_API_HOST: Worker 容器内 mineru-api 服务绑定的监听 IP。
# 可选值: 0.0.0.0 (容器内必须监听全部接口以响应网关请求)。
MINERU_API_HOST=0.0.0.0
# MINERU_API_PORT: Worker 容器内 mineru-api 监听端口。
# 可选值: 1 ~ 65535 的整数，推荐 8000。
MINERU_API_PORT=8000
# MINERU_API_ENABLE_VLM_PRELOAD: 是否在容器启动时立即加载 VLM 大模型显存。
# 可选值:
#   - false (推荐！保持冷启动待机，请求到来时才载入显卡，实现 0 VRAM 占用)
#   - true (容器启动即加载权重并长驻显存，启动略慢但首个请求响应更快)
MINERU_API_ENABLE_VLM_PRELOAD=false
# MINERU_DEVICE_MODE: 推理加速引擎模式。
# 可选值:
#   - cuda (使用 NVIDIA GPU CUDA 加速推理，RTX 5090 必须使用此项)
#   - cpu (纯 CPU 推理，速度极慢，仅用于无显卡环境验证)
MINERU_DEVICE_MODE=cuda
# MINERU_API_OUTPUT_ROOT: Worker 容器内的中间任务临时产物输出目录。
# 可选值: 绝对路径，推荐 /usr/model/MinerU/data/worker_output。
MINERU_API_OUTPUT_ROOT=/usr/model/MinerU/data/worker_output
# MINERU_PROCESSING_WINDOW_SIZE: 版面分析滑动窗口大小。
# 可选值: 正整数，如 32, 64, 128（默认 64）。
# 值越大能捕获更大跨页上下文，但略增加显存开销。
MINERU_PROCESSING_WINDOW_SIZE=64
# MINERU_API_MAX_CONCURRENT_REQUESTS: Worker 内部最大并发推理请求数。
# 可选值: 正整数，推荐 1。
# 单卡 5090 采用分批串行推理能彻底规避显存突发超额导致的 CUDA OOM。
MINERU_API_MAX_CONCURRENT_REQUESTS=1
# MINERU_API_ENABLE_FASTAPI_DOCS: 是否开放 Worker 容器自身的 FastAPI Swagger /docs 接口文档。
# 可选值:
#   - true (默认值，开放 Worker 容器本身的 /docs 与 /openapi.json 接口文档)
#   - false (关闭 Worker 容器自带文档)
MINERU_API_ENABLE_FASTAPI_DOCS=true
# MINERU_API_TASK_RETENTION_SECONDS: Worker 内部历史任务缓存保留时长（秒）。
# 可选值: 正整数，默认 86400（即 24 小时）。
# 超出此时长的已完成/失败任务产物将被 Worker 自动轮询清理。
MINERU_API_TASK_RETENTION_SECONDS=86400
# MINERU_API_TASK_CLEANUP_INTERVAL_SECONDS: Worker 内部清理过期任务的轮询间隔（秒）。
# 可选值: 正整数，默认 300（即每 5 分钟执行一次过期任务清理扫描）。
MINERU_API_TASK_CLEANUP_INTERVAL_SECONDS=300


# ------------------------------------------------------------------------------
# 8. 模型下载与缓存目录配置 (Model Cache & Download Settings)
# 说明：执行 `./docs/deploy/compose.sh download` 时，会自动从以下配置读取
# 渠道和模型类型，直接启动临时容器下载，无需手敲任何命令行参数。
# ------------------------------------------------------------------------------
# MINERU_DOWNLOAD_SOURCE: 模型权重下载渠道。
# 可选值:
#   - modelscope (推荐，国内阿里云 ModelScope 镜像，下载快速稳定)
#   - huggingface (从 Hugging Face 官方仓库下载)
MINERU_DOWNLOAD_SOURCE=modelscope
# MINERU_DOWNLOAD_MODELS: 需要下载的模型分类。
# 可选值:
#   - all (下载全部模型，包含 pipeline 版面模型和 vlm 视觉模型，推荐)
#   - pipeline (仅下载版面、公式、表格等传统 pipeline 辅助模型)
#   - vlm (仅下载视觉多模态大模型权重)
MINERU_DOWNLOAD_MODELS=all
# MODELSCOPE_CACHE: ModelScope 框架的模型缓存目录。
# 可选值: 挂载卷内的绝对路径，推荐 /usr/model/MinerU/cache/modelscope。
MODELSCOPE_CACHE=/usr/model/MinerU/cache/modelscope
# HF_HOME: Hugging Face 框架的模型与权重缓存目录。
# 可选值: 挂载卷内的绝对路径，推荐 /usr/model/MinerU/cache/huggingface。
HF_HOME=/usr/model/MinerU/cache/huggingface
# TORCH_HOME: PyTorch Hub 模型缓存目录。
# 可选值: 挂载卷内的绝对路径，推荐 /usr/model/MinerU/cache/torch。
TORCH_HOME=/usr/model/MinerU/cache/torch
# XDG_CACHE_HOME: 通用应用程序缓存主目录。
# 可选值: 挂载卷内的绝对路径，推荐 /usr/model/MinerU/cache。
XDG_CACHE_HOME=/usr/model/MinerU/cache

# ------------------------------------------------------------------------------
# 9. 默认文档解析行为选项 (Default Parsing Options)
# 说明：这些是网关发起解析任务的默认参数兜底。实际 API 请求中若传入了相应字段，则以请求参数优先。
# ------------------------------------------------------------------------------
# DEFAULT_BACKEND: 默认解析后端。
# 可选值:
#   - hybrid-engine (推荐，结合版面模型与大模型的多模态混合解析引擎，精度与速度平衡最佳)
#   - pipeline (传统轻量版面分析后端，无需大模型推理)
#   - vlm (纯多模态大模型解析引擎)
DEFAULT_BACKEND=hybrid-engine
# DEFAULT_EFFORT: 解析精细度等级。
# 可选值:
#   - low (低精细度，解析速度最快，适用于文字为主的简单排版)
#   - medium (平衡推荐，兼顾排版识别率与解析耗时)
#   - high (高精细度，全面增强复杂公式、跨列排版及细小图表提取)
DEFAULT_EFFORT=medium
# DEFAULT_PARSE_METHOD: 文本提取与 OCR 解析方式。
# 可选值:
#   - auto (自动判断：电子文字版 PDF 直接抽取文本，扫描件自动走 OCR 识别)
#   - txt (强制仅按文本层抽取，遇到扫描件无文本时可能为空)
#   - ocr (强制全部页面通过 OCR 光学字符识别处理)
DEFAULT_PARSE_METHOD=auto
# ------------------------------------------------------------------------------
# MINERU_FORMULA_ENABLE: Worker 全局行内与独立数学公式检测及 LaTeX 转换开关。
# 可选值:
#   - true (默认值，启用公式检测与 LaTeX 公式提取)
#   - false (禁用公式提取，将其作为普通文本或图片区域处理)
MINERU_FORMULA_ENABLE=true
# MINERU_FORMULA_CH_SUPPORT: 中文公式提取优化（原生实验性特性，仅 pipeline 模式生效）。
# 可选值:
#   - false (默认值，不开启中文公式实验模型)
#   - true (开启中文公式优化，使用 MFR 中文强化权重)
MINERU_FORMULA_CH_SUPPORT=false
# MINERU_TABLE_ENABLE: Worker 全局表格结构识别与 HTML/Markdown 提取开关。
# 可选值:
#   - true (默认值，启用表格识别模块)
#   - false (禁用表格解析，作为纯文本或图片处理)
MINERU_TABLE_ENABLE=true
# MINERU_TABLE_MERGE_ENABLE: 跨页表格智能识别与连续合并。
# 可选值:
#   - true (默认值，自动识别跨页断开的长表格并合并为一个完整表格)
#   - false (禁用跨页表格合并，各页表格独立输出)
MINERU_TABLE_MERGE_ENABLE=true
# MINERU_OCR_DET_MASK_INLINE_FORMULA_ENABLE: OCR 检测时在行内公式区域打掩码避免字符误识别。
# 可选值:
#   - true (默认值，行内公式区域添加掩码遮罩，避免 OCR 将复杂数学符号误识为乱码文字)
#   - false (不添加公式掩码)
MINERU_OCR_DET_MASK_INLINE_FORMULA_ENABLE=true
# DEFAULT_FORMULA_ENABLE: 是否启用数学公式检测与 LaTeX 格式转换。
# 可选值: true, false。
DEFAULT_FORMULA_ENABLE=true
# DEFAULT_TABLE_ENABLE: 是否启用复杂表格结构识别与 HTML/Markdown 表格提取。
# 可选值: true, false。
DEFAULT_TABLE_ENABLE=true
# DEFAULT_IMAGE_ANALYSIS: 是否启用插图切分与多模态图表理解分析。在 effort=medium 时会自动关闭
# 可选值: true, false。
DEFAULT_IMAGE_ANALYSIS=false
