# ==========================================
# MinerU-Sentry Environment Configuration
# ==========================================

# Server Configuration
SENTRY_HOST=0.0.0.0
SERVICE_PORT=8080
LOG_PATH=logs
LOG_NAME=mineru-sentry
LOG_LEVEL=INFO

# Database (PostgreSQL)
# Copy this file to core/config/.env.dev; select another file with CONFIG_FILE_PATH.
# Process environment variables override file values.
POSTGRES_URL=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DATABASE=mineru_sentry
POSTGRES_USERNAME=mineru_admin
POSTGRES_PASSWORD=mineru_password

# Docker & GPU Lifecycle Management
DOCKER_HOST=unix:///var/run/docker.sock
MINERU_WORKER_CONTAINER_NAME=mineru_gpu_worker
MINERU_API_URL=http://mineru_worker:8000
IDLE_TIMEOUT_SECONDS=900
WORKER_STARTUP_TIMEOUT_SECONDS=300
WORKER_TASK_TIMEOUT_SECONDS=3600
PARSE_BATCH_PAGES=1

# Shared Storage Paths (Must match host and container mount paths)
HOST_MINERU_DIR=/usr/model/MinerU
SHARED_DATA_DIR=/usr/model/MinerU/data
MINERU_CONFIG_FILE=/usr/model/MinerU/mineru.json

# Default Parsing Options
DEFAULT_BACKEND=hybrid-engine
DEFAULT_EFFORT=medium
DEFAULT_PARSE_METHOD=auto
DEFAULT_FORMULA_ENABLE=true
DEFAULT_TABLE_ENABLE=true
DEFAULT_IMAGE_ANALYSIS=true
